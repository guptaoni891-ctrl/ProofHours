# ProofHours V2 services. Copy to server/.env (gitignored) and start with Node's built-in loader:
#   node --env-file=.env attendance.js
#   node --env-file=.env indexer.js
# Never commit a real ATTENDANCE_SECRET. In staging/production read it from a secret store (and move the
# vault and issuer keys to a KMS: see docs/V2_SECURITY_MODEL.md).

# --- shared by both services ---
RPC_URL=http://127.0.0.1:8546
CHAIN_ID=31337
# V2 contract addresses. These defaults are the deterministic LOCAL deployment (docs/config.js).
# Base Sepolia: fill in only after the approved deployment (docs/V2_DEPLOYMENT_PLAN.md).
LEDGER=0xd714101097150109C3b0D8d30451280680ED44bA
BADGES=0x64d4972B737C1ECfab6FEdE9AD201D28660a35F4
RATE_LIMIT=300
LOG_REQUESTS=1
# Behind a reverse proxy: 1 = rate-limit per client using the proxy's last X-Forwarded-For hop (else everyone shares one bucket)
TRUST_PROXY=0
# Bearer token for GET /metrics through a proxy (unset: direct loopback connections only)
METRICS_TOKEN=
# Confirmations before trusting a receipt (attendance: default 1 locally, 3 on public chains)
# CONFIRMATIONS=

# --- attendance service (attendance.js) ---
# Required, attendance service ONLY (never give it to the indexer). 32+ random bytes, hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATTENDANCE_SECRET=
PORT=8790
ATTENDANCE_DB=./data/attendance.sqlite
# Keep on a different volume/backup schedule from ATTENDANCE_DB (crypto-shredding depends on it).
VAULT_KEYS_DB=./data/vault-keys.sqlite
# Public base URL of this service; it appears in credentials (status list URL). Must be stable.
PUBLIC_URL=http://127.0.0.1:8790
# Front-end origin(s) allowed to request a Sign-In with Ethereum message, comma-separated. Required on public chains;
# unset locally = http://localhost:* and http://127.0.0.1:* only.
# APP_ORIGINS=https://your-org.github.io

# --- indexer (indexer.js); run it with its own env file or override these ---
# PORT=8792
# RATE_LIMIT=600
# INDEXER_DB=./data/indexer.sqlite
# CONFIRMATIONS=2     # default 2 locally, 12 on public chains
# START_BLOCK=        # required on public chains; empty on a local fork: found automatically
# POLL_MS=2000
# Public key that verifies sign-in sessions for auditor views (printed by attendance.js; also GET /auth/public-key).
# SESSION_PUBLIC_KEY=
